# ============================================================
# Front
# ============================================================
FRONT_API_KEY=
FRONT_API_URL=https://api2.frontapp.com
# Front tag ID for the "Linked" tag (e.g. tag_27f7wp)
LINKED_TAG_ID=

# ============================================================
# OpenAI
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# ============================================================
# Scheduler
# ============================================================
# How often the link check loop fires (hours)
CHECK_INTERVAL_HOURS=6
# Set to "true" to run an immediate check when the server starts
RUN_ON_STARTUP=false

# Quiet window — scheduler skips runs when local hour is in [START, END).
# Default 23..6 = 11 PM to 6 AM in TIMEZONE. Manual /api/check ignores this.
QUIET_HOURS_START=23
QUIET_HOURS_END=6
TIMEZONE=America/Denver

# ============================================================
# Application
# ============================================================
# Railway mounts volumes at /data — local default falls back to ./links.db
DATABASE_PATH=links.db
HOST=0.0.0.0
PORT=8000
